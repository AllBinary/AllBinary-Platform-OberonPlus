function TGeographicMapTopViewLayerBehavior.hasSolidBlock(geographicMapInterfaceArray: TArray<TBasicGeographicMap>; geographicMapCellTypeArray: TArray<TGeographicMapCellType>): Boolean;
var
  size: Integer;
  basicTopViewGeographicMapCellTypeFactory_: TBasicTopViewGeographicMapCellTypeFactory;
  index: Integer;
begin
        size := System.Length(geographicMapInterfaceArray);
        
        for index := 0 to size - 1 do begin
            basicTopViewGeographicMapCellTypeFactory_ := TBasicTopViewGeographicMapCellTypeFactory(TJava.ToObject(geographicMapInterfaceArray[index].getGeographicMapCellTypeFactory()));
            if basicTopViewGeographicMapCellTypeFactory_.BLOCK_CELL_TYPE.isType(geographicMapCellTypeArray[index]) then begin
                Exit(True);
            end;
        end;
        Exit(False);
end;
    

function TGeographicMapTopViewLayerBehavior.isOffMap(geographicMapInterfaceArray: TArray<TBasicGeographicMap>; geographicMapCellTypeArray: TArray<TGeographicMapCellType>): Boolean;
var
  size: Integer;
